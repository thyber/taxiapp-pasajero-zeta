<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_suggestion_item"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/txtSuggestionIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📍"
        android:textSize="32sp"
        android:layout_marginEnd="16dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtSuggestionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del lugar"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1f2937" />

        <TextView
            android:id="@+id/txtSuggestionAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dirección completa"
            android:textSize="14sp"
            android:textColor="#6b7280"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
