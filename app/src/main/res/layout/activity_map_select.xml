<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <!-- MAPA A PANTALLA COMPLETA -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />



    <!-- CAJA FLOTANTE: TIEMPO, KM, TARIFA -->
    <LinearLayout
        android:id="@+id/fareInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_top_rounded_modern"
        android:padding="16dp"
        android:elevation="16dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="50dp">

        <!-- TIEMPO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️"
                android:textSize="24sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 min"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1e293b" />

        </LinearLayout>

        <!-- SEPARADOR -->
        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="#e5e7eb"
            android:layout_marginEnd="20dp" />

        <!-- DISTANCIA -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="24sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 km"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1e293b" />

        </LinearLayout>

        <!-- SEPARADOR -->
        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="#e5e7eb" />

        <!-- TARIFA -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰"
                android:textSize="24sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtFare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bs 0"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#166534" />

        </LinearLayout>

    </LinearLayout>

    <!-- BOTÓN ATRÁS (IZQUIERDA SUPERIOR) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_media_previous"
        android:backgroundTint="#ffffff"
        android:tint="#1f2937"
        app:elevation="6dp" />

    <!-- PANEL INFERIOR (DESLIZABLE) -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_top_rounded"
        android:elevation="16dp"
        android:padding="24dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- BARRA INDICADORA -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#e5e7eb"
            android:layout_marginBottom="16dp" />

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUSCAR DIRECCIÓN"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1f2937"
            android:layout_marginBottom="12dp" />

        <!-- CAMPO DE BÚSQUEDA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#6b7280"
                android:layout_marginEnd="12dp" />

            <EditText
                android:id="@+id/etSearchDestination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Escribe una dirección..."
                android:textSize="16sp"
                android:textColor="#1f2937"
                android:background="@null"
                android:inputType="text"
                android:singleLine="true" />

        </LinearLayout>

        <!-- SUGERENCIAS DE BUSQUEDA -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:maxHeight="250dp" />

        <!-- SEPARADOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#f3f4f6"
            android:layout_marginBottom="16dp" />

        <!-- DIRECCIÓN SELECCIONADA (OCULTA POR DEFECTO) -->
        <LinearLayout
            android:id="@+id/layoutDestino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_flag_black"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDestName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1f2937" />

                <TextView
                    android:id="@+id/txtDestAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#6b7280"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>
        
        <!-- TIPO DE SERVICIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de servicio"
                android:textSize="14sp"
                android:textColor="#6b7280"
                android:layout_marginBottom="8dp" />
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <LinearLayout
                    android:id="@+id/btnServiceByDistance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_vehicle_type_selected"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚗"
                        android:textSize="24sp"
                        android:layout_marginBottom="4dp" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Por Distancia"
                        android:textSize="12sp"
                        android:textColor="#2563eb" />
                        
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/btnServiceByHour"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_vehicle_type"
                    android:padding="12dp"
                    android:layout_marginStart="8dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️"
                        android:textSize="24sp"
                        android:layout_marginBottom="4dp" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Por Hora"
                        android:textSize="12sp"
                        android:textColor="#6b7280" />
                        
                </LinearLayout>
                
            </LinearLayout>
            
        </LinearLayout>

        <!-- DETALLES DE LA CARRERA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_edit"
                android:layout_marginEnd="16dp" />

            <EditText
                android:id="@+id/etRideDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Detalles (ej: vagoneta con parrilla, mascota, color de casa, # de casa)"
                android:textSize="14sp"
                android:textColor="#6b7280"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:inputType="textMultiLine"
                android:minLines="2" />

        </LinearLayout>

        <!-- BOTÓN SOLICITAR TAXI -->
        <Button
            android:id="@+id/btnSolicitarTaxi"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Listo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#ef4444"
            android:textColor="#ffffff"
            android:elevation="4dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
