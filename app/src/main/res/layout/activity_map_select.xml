<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <!-- MAPA A PANTALLA COMPLETA -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- PIN CENTRO (BANDERA ROJA) -->
    <ImageView
        android:id="@+id/pinCentro"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_flag_red"
        android:elevation="12dp" />

    <!-- TARIFA Y DISTANCIA ARRIBA DEL PIN -->
    <LinearLayout
        android:id="@+id/fareInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_white_rounded"
        android:padding="12dp"
        android:elevation="12dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_car"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtFareInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculando..."
                android:textSize="14sp"
                android:textColor="#374151" />

            <TextView
                android:id="@+id/txtFare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bs 0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1f2937" />

        </LinearLayout>

    </LinearLayout>

    <!-- BOTÓN ATRÁS (IZQUIERDA SUPERIOR) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_media_previous"
        android:backgroundTint="#ffffff"
        android:tint="#1f2937"
        app:elevation="6dp" />

    <!-- PANEL INFERIOR -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_top_rounded"
        android:elevation="16dp"
        android:padding="24dp">

        <!-- BARRA INDICADORA -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#e5e7eb"
            android:layout_marginBottom="16dp" />

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIRECCIÓN DE DESTINO"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1f2937"
            android:layout_marginBottom="12dp" />

        <!-- SEPARADOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#f3f4f6"
            android:layout_marginBottom="16dp" />

        <!-- DIRECCIÓN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_flag_black"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDestName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calle 21"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1f2937" />

                <TextView
                    android:id="@+id/txtDestAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Santa Cruz de la Sierra"
                    android:textSize="14sp"
                    android:textColor="#6b7280"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- BOTÓN SOLICITAR TAXI -->
        <Button
            android:id="@+id/btnSolicitarTaxi"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Listo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#ef4444"
            android:textColor="#ffffff"
            android:elevation="4dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
